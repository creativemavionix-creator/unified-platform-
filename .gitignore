# =============================================================================
# MaVionix monorepo — root .gitignore
# Covers Next.js app, Vite dashboards, Python APIs, and local tooling.
# =============================================================================

# ----- Dependencies -----
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/install-state.gz
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store/

# ----- Next.js -----
.next/
out/
.vercel/

# ----- Vite / frontend builds -----
dist/
build/
.vite/
.turbo/
*.local

# ----- Testing / coverage -----
coverage/
.nyc_output/
playwright-report/
test-results/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.egg
.ipynb_checkpoints/

# ----- Environment & secrets -----
.env
.env.*
!.env.example
!.env*.example
!.env.sample
*.pem
*.key
credentials.json
service-account*.json
**/secrets/

# ----- Logs & debug -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed

# ----- OS / editors -----
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ----- TypeScript -----
*.tsbuildinfo

# Keep Next's ambient types in the repo (regenerated by next build/dev).
# next-env.d.ts

# ----- Caches / temp -----
.cache/
.tmp/
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig

# ----- Runtime / generated media (photo editor, APIs) -----
**/static/outputs/
**/runtime-logs/
**/tmp-*/
**/demo_output/
**/uploads/
**/generated/
**/gfpgan/
**/weights/
**/*.pt
**/*.pth
**/*.onnx
**/*.ckpt
!**/.gitkeep

# ----- Misc tooling -----
.eslintcache
.stylelintcache
.parcel-cache
.sass-cache/
.supabase/.temp/
